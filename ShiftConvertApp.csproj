<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ShiftConvert</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Единый автономный EXE без лишних файлов, 0% CPU в простое -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <NuGetAudit>false</NuGetAudit>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefaultItemExcludes>$(DefaultItemExcludes);ShellExt\**</DefaultItemExcludes>
  </PropertyGroup>

  <Target Name="CompileExplorerShellExt" BeforeTargets="BeforeBuild;PrepareResourceNames">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:library /platform:x64 /optimize+ /out:&quot;$(BaseIntermediateOutputPath)ShiftConvertShellExt.dll&quot; &quot;$(MSBuildProjectDirectory)\ShellExt\ShiftConvertShellExt.cs&quot;" />
  </Target>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)ShiftConvertShellExt.dll" LogicalName="ShiftConvertShellExt.dll" />
  </ItemGroup>

</Project>
